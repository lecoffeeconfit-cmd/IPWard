{
  "expo": {
    "name": "IPward",
    "slug": "ipward",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sentryward-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lecoffeeconfit.ipward",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/sentryward-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.ipward.mobile"
    },
    "web": {
      "favicon": "./assets/sentryward-favicon.png",
      "bundler": "metro",
      "name": "IPward — Your phone, visible"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-sharing"
    ],
    "scheme": "ipward",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f3685fb-dcf2-4ab8-8f13-d1453a1566d5"
      }
    },
    "owner": "lecoffeeconfit"
  }
}
